{
  "name": "onemenu",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "start": "DISABLE_ESLINT_PLUGIN=true PORT=8080 craco start",
    "build": "DISABLE_ESLINT_PLUGIN=true craco build",
    "test": "craco test --watchAll=false --coverage",
    "test:watch": "craco test",
    "eject": "react-scripts eject",
    "env:pull": "scp git@192.168.0.100:www/onemenu/.env .env",
