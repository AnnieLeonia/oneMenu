{
  "name": "onemenu",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "postinstall": "npm-run-all -p install-client install-server",
    "install-client": "cd client && npm install",
    "install-server": "cd server && npm install",
    "start": "npm-run-all -p start-server start-client",
    "start-client": "cd client && npm start",
    "start-server": "cd server && npm start",
    "build": "npm-run-all -s build-client",
    "build-client": "cd client && npm run build",
    "test": "npm-run-all -s test-client",
    "test-client": "cd client && npm test",
    "test-server": "cd server && npm test",
    "db:migrate": "./server/migrations/run.sh",
    "env:pull": "scp gha@codies.se:/opt/stacks/onemenu/.env .env",
    "db:pull": "ssh dev@codies.se \"docker exec postgres pg_dump --format=c -U vicnie onemenu\" | docker exec -i private-postgres pg_restore --clean --no-owner -U postgres -d onemenu"
  },
  "dependencies": {
    "dotenv": "10.0.0",
    "npm-run-all": "4.1.5"
  },
  "devDependencies": {
    "husky": "^4.3.8",
    "lint-staged": "^10.5.4",
    "prettier": "^2.4.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": "prettier --write"
  },
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnnieLeonia/onemenu.git"
  },
  "author": "VictorWinberg, AnnieLeonia",
  "license": "ISC"
}
